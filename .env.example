# Copy to .env and adjust. All variables are optional.

# Which Company Pack the operator works for (folder under company_packs/).
ACO_COMPANY_PACK=quickbite

# Operator API.
ACO_API_HOST=127.0.0.1
ACO_API_PORT=8000

# Sandboxed QuickBite systems.
ACO_SANDBOX_URL=http://127.0.0.1:8100

# Set to false to watch the browser while the agent works.
ACO_BROWSER_HEADLESS=true
# Path to a Chromium binary, if not using the one installed by `playwright install`.
ACO_BROWSER_EXECUTABLE=

# Language model.
#   gemini              Google Gemini (free key at https://aistudio.google.com)
#   openai_compatible   Groq, OpenRouter, Ollama, OpenAI... (also set ACO_LLM_BASE_URL)
ACO_LLM_PROVIDER=gemini
# Comma-separated; the next model takes over when one is overloaded.
ACO_LLM_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
ACO_LLM_API_KEY=
ACO_LLM_BASE_URL=
# Seconds between model calls (free tiers limit requests per minute).
ACO_LLM_MIN_INTERVAL=2
